  "orientation": "orthogonal",
  "tileSize": 16,
  "width": 24,
  "height": 14,
  "legend": {"#": "wall", "a": "floor-a", "b": "floor-b"},
  "layers": [{"id": "ground", "rows": [
    "########################",
    "#bababababab#bababababa#",
