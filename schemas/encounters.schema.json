{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EncounterCatalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "encounters": {"type":"array","minItems":1,"maxItems":64,"items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:encounter\\.[a-z][a-z0-9.-]{0,95}$"},
        "name":{"type":"string","pattern":"^[^\\u0000-\\u001f]{1,80}$"},
        "seed":{"type":"integer","minimum":0,"maximum":4294967295},
        "hero":{"$ref":"#/definitions/combatant"},
        "enemy":{"$ref":"#/definitions/combatant"}
      },"required":["id","name","seed","hero","enemy"]
    }}
  },
  "definitions":{"combatant":{"type":"object","additionalProperties":false,"properties":{
    "name":{"type":"string","pattern":"^[^\\u0000-\\u001f]{1,80}$"},
    "hp":{"type":"integer","minimum":1,"maximum":999},
    "attack":{"type":"integer","minimum":1,"maximum":999},
    "defense":{"type":"integer","minimum":0,"maximum":999}
  },"required":["name","hp","attack","defense"]}},
  "required":["schemaVersion","encounters"]
}
