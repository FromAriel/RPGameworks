{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ItemCatalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "categories": {
      "description": "The Items screen's categories in tab order (decision 0016 Q2). Optional: without it the categories are Consumables, Key Items and Materials (consumables, key, materials). Labels are string keys in strings.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "labelKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        },
        "required": [
          "id",
          "labelKey"
        ]
      }
    },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}:item\\.[a-z][a-z0-9.-]{0,95}$"
          },
          "nameKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "descriptionKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "maxStack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "category": {
            "description": "The item's category ID (decision 0016 Q2), one of the catalog's categories. Without it the item belongs to the first category.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "battleUse": {
            "description": "Optional use during battle. Only healing exists so far (M5.3).",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heal"
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              }
            },
            "required": [
              "type",
              "amount"
            ]
          }
        },
        "required": [
          "id",
          "nameKey",
          "descriptionKey",
          "maxStack"
        ]
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,1500}$"
          }
        }
      },
      "required": [
        "en"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "capacity",
    "items",
    "strings"
  ]
}
