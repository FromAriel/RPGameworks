    "#bababababab#bababababa#",
    "#ababababababababababab#",
    "########################"
  ]}],
  "collision": [
    "########################",
    "#...........#..........#",
    "#...........#..........#",
    "#...........#..........#",
    "#...........#..........#",
    "#...........#..........#",
