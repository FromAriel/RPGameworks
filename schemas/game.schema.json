{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:game\\.[a-z][a-z0-9.-]{0,95}$"},
    "tileSize": {"const": 32},
    "view": {
      "description": "Logical canvas size in game pixels; enlarged by whole numbers to fit the screen.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 160, "maximum": 1920},
        "height": {"type": "integer", "minimum": 120, "maximum": 1080}
      }, "required": ["width", "height"]
    },
    "itemsFile": {"type": "string", "pattern": "^items(\\.[a-f0-9]{12})?\\.json$"},
    "factsFile": {"type": "string", "pattern": "^facts(\\.[a-f0-9]{12})?\\.json$"},
    "questsFile": {"type": "string", "pattern": "^quests(\\.[a-f0-9]{12})?\\.json$"},
    "encountersFile": {"type": "string", "pattern": "^encounters(\\.[a-f0-9]{12})?\\.json$"},
    "uiThemeFile": {"type": "string", "pattern": "^ui-theme(\\.[a-f0-9]{12})?\\.json$"},
    "menuFile": {"type": "string", "pattern": "^menu(\\.[a-f0-9]{12})?\\.json$", "description": "The main menu definition (decision 0016)."},
    "catalogs": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "file"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "file": {"type": "string", "pattern": "^catalogs/[a-z0-9-]+(\\.[a-f0-9]{12})?\\.json$"}}}, "description": "Data-only menu screens (decision 0016 U2.4): a menu entry on builtin:catalog names one by id."},
    "creaturesFile": {"type": "string", "pattern": "^creatures(\\.[a-f0-9]{12})?\\.json$", "description": "Generated: the baked creature atlas frame table (decision 0015 C3)."},
    "stateIndexFile": {"type": "string", "pattern": "^state-index(\\.[a-f0-9]{12})?\\.json$"},
    "saveCompatibilityVersion": {"type": "integer", "minimum": 1, "maximum": 65535},
    "start": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mapId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:map\\.[a-z][a-z0-9.-]{0,95}$"},
        "spawnId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
      }, "required": ["mapId", "spawnId"]
    },
    "maps": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:map\\.[a-z][a-z0-9.-]{0,95}$"},
          "file": {"type": "string", "pattern": "^maps/[a-z][a-z0-9-]{0,63}(\\.[a-f0-9]{12})?\\.json$"}
        }, "required": ["id", "file"]
      }
    }
  },
  "required": ["schemaVersion", "id", "tileSize", "view", "start", "maps"]
}
