{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EncounterCatalog",
  "description": "Version 2: a party and an enemy group on a visible turn timeline (decision 0006).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 2},
    "encounters": {"type":"array","minItems":1,"maxItems":64,"items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:encounter\\.[a-z][a-z0-9.-]{0,95}$"},
        "name":{"type":"string","pattern":"^[^\\u0000-\\u001f]{1,80}$"},
        "seed":{"type":"integer","minimum":0,"maximum":4294967295},
        "party":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/definitions/combatant"}},
        "enemies":{"type":"array","minItems":1,"maxItems":6,"items":{"$ref":"#/definitions/combatant"}}
      },"required":["id","name","seed","party","enemies"]
    }}
  },
  "definitions":{"combatant":{"type":"object","additionalProperties":false,"properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},
    "name":{"type":"string","pattern":"^[^\\u0000-\\u001f]{1,80}$"},
    "frame":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "hp":{"type":"integer","minimum":1,"maximum":999},
    "attack":{"type":"integer","minimum":1,"maximum":999},
    "defense":{"type":"integer","minimum":0,"maximum":999},
    "speed":{"type":"integer","minimum":1,"maximum":99}
  },"required":["id","name","frame","hp","attack","defense","speed"]}},
  "required":["schemaVersion","encounters"]
}
