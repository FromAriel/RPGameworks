{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapDefinition",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "condition": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"all"},"conditions":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/definitions/condition"}}},"required":["type","conditions"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"any"},"conditions":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/definitions/condition"}}},"required":["type","conditions"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"not"},"condition":{"$ref":"#/definitions/condition"}},"required":["type","condition"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"factEquals"},"factId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:fact\\.[a-z][a-z0-9.-]{0,95}$"},"value":{"type":"boolean"}},"required":["type","factId","value"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"itemAtLeast"},"itemId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:item\\.[a-z][a-z0-9.-]{0,95}$"},"quantity":{"type":"integer","minimum":0,"maximum":9999}},"required":["type","itemId","quantity"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"placementOpened"},"placementId":{"anyOf":[{"const":"self"},{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:object\\.[a-z][a-z0-9.-]{0,95}$"}]},"value":{"type":"boolean"}},"required":["type","placementId","value"]}
      ]
    },
    "action": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"setFact"},"factId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:fact\\.[a-z][a-z0-9.-]{0,95}$"},"value":{"type":"boolean"}},"required":["type","factId","value"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"changeItem"},"itemId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:item\\.[a-z][a-z0-9.-]{0,95}$"},"delta":{"type":"integer","minimum":-9999,"maximum":9999,"not":{"const":0}}},"required":["type","itemId","delta"]},
        {"type":"object","additionalProperties":false,"properties":{"type":{"const":"markPlacementOpened"},"placementId":{"anyOf":[{"const":"self"},{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}:object\\.[a-z][a-z0-9.-]{0,95}$"}]}},"required":["type","placementId"]}
      ]
    },
    "interaction": {
      "type":"object","additionalProperties":false,
      "properties":{
        "messageId":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},
        "rejectionMessageId":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},
        "actions":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/definitions/action"}}
      },
      "required":["messageId"]
    },
    "objectState": {
      "type":"object","additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},
        "when":{"$ref":"#/definitions/condition"},
        "fallback":{"const":true},
        "frame":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
        "visible":{"type":"boolean"},
        "interaction":{"$ref":"#/definitions/interaction"}
      },
      "required":["id","frame","visible"],
      "oneOf":[{"properties":{"when":{}},"required":["when"]},{"properties":{"fallback":{}},"required":["fallback"]}]
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:map\\.[a-z][a-z0-9.-]{0,95}$"},
    "name": {"type": "string", "pattern": "^[^\\u0000-\\u001f]{1,80}$"},
    "orientation": {"const": "orthogonal"},
    "tileSize": {"const": 16},
    "width": {"type": "integer", "minimum": 1, "maximum": 128},
    "height": {"type": "integer", "minimum": 1, "maximum": 128},
    "legend": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9#_~-]$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "layers": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "rows": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "pattern": "^[A-Za-z0-9.#_~-]{1,128}$"}}
        }, "required": ["id", "rows"]
      }
    },
    "collision": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "pattern": "^[.#]{1,128}$"}},
    "defaultSpawn": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "spawns": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "x": {"type": "integer", "minimum": 0, "maximum": 127},
          "y": {"type": "integer", "minimum": 0, "maximum": 127},
          "facing": {"enum": ["up", "down", "left", "right"]}
        }, "required": ["id", "x", "y", "facing"]
      }
    },
    "objects": {
      "type": "array", "minItems": 0, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:object\\.[a-z][a-z0-9.-]{0,95}$"},
          "frame": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "x": {"type": "integer", "minimum": 0, "maximum": 127},
          "y": {"type": "integer", "minimum": 0, "maximum": 127},
          "solid": {"type": "boolean"},
          "messageId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "states": {"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/definitions/objectState"}},
          "chest": {"type": "object", "additionalProperties": false, "properties": {"itemId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:item\\.[a-z][a-z0-9.-]{0,95}$"}, "quantity": {"type": "integer", "minimum": 1, "maximum": 9999}, "openedFrame": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "openedMessageId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "emptyMessageId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}, "required": ["itemId", "quantity", "openedFrame", "openedMessageId", "emptyMessageId"]}
        }, "required": ["id", "frame", "x", "y", "solid"]
      }
    },
    "exits": {
      "type": "array", "minItems": 0, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "x": {"type": "integer", "minimum": 0, "maximum": 127},
          "y": {"type": "integer", "minimum": 0, "maximum": 127},
          "width": {"type": "integer", "minimum": 1, "maximum": 128},
          "height": {"type": "integer", "minimum": 1, "maximum": 128},
          "targetMap": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:map\\.[a-z][a-z0-9.-]{0,95}$"},
          "targetSpawn": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        }, "required": ["id", "x", "y", "width", "height", "targetMap", "targetSpawn"]
      }
    },
    "strings": {"type": "object", "additionalProperties": false, "properties": {"en": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "additionalProperties": {"type": "string", "pattern": "^[\\s\\S]{1,1500}$"}}}, "required": ["en"]},
    "messages": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "speakerKey": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "pages": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}}}, "required": ["id", "speakerKey", "pages"]}}
  },
  "required": ["schemaVersion", "id", "name", "orientation", "tileSize", "width", "height", "legend", "layers", "collision", "defaultSpawn", "spawns", "objects", "exits"]
}
