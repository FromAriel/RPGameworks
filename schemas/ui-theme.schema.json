{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UiTheme",
  "description": "Window looks baked by tools/bake-frames.ts from the Pixel Frame core (decision 0010). Cosmetic only.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
    "window": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "pattern": "^[^\u0000-\u001f]{1,200}$"},
        "frame": {
          "description": "A catalog style, or a custom bevel profile (heights from the outer edge inward) and corner art.",
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "properties": {"style": {"enum": ["flat", "round", "rail", "riveted", "gem", "fleur", "rosette", "filigree", "inset", "neutral", "plate", "thumb"]}},
              "required": ["style"]
            },
            {
              "type": "object", "additionalProperties": false,
              "properties": {
                "profile": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 1, "maximum": 9}},
                "corner": {"description": "Corner art; omit for plain square corners.", "enum": ["notch", "rivetBoss", "squareBoss", "plateCorner", "gemBoss", "rosette", "fleur", "fleurDiagonal", "scroll", "cornerRivet"]}
              },
              "required": ["profile"]
            }
          ]
        },
        "ornament": {"enum": ["small", "medium", "large"]},
        "colors": {
          "description": "A named theme, one base colour (a whole theme is generated), or an explicit border ramp from dark to light.",
          "oneOf": [
            {"type": "object", "additionalProperties": false, "properties": {"theme": {"enum": ["iron", "brass", "silver", "obsidian"]}}, "required": ["theme"]},
            {"type": "object", "additionalProperties": false, "properties": {"base": {"$ref": "#/definitions/hex"}}, "required": ["base"]},
            {"type": "object", "additionalProperties": false, "properties": {"ramp": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"$ref": "#/definitions/hex"}}}, "required": ["ramp"]}
          ]
        },
        "light": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "azimuth": {"type": "integer", "minimum": 0, "maximum": 359},
            "elevation": {"type": "integer", "minimum": 5, "maximum": 90},
            "steps": {"type": "integer", "minimum": 3, "maximum": 8},
            "outline": {"type": "boolean"},
            "shadow": {"type": "boolean"}
          },
          "required": ["azimuth", "elevation", "steps", "outline", "shadow"]
        },
        "fill": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "none"}}, "required": ["kind"]},
            {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "flat"}, "color": {"$ref": "#/definitions/hex"}}, "required": ["kind", "color"]},
            {
              "type": "object", "additionalProperties": false,
              "properties": {"kind": {"const": "bands"}, "top": {"$ref": "#/definitions/hex"}, "bottom": {"$ref": "#/definitions/hex"}, "band": {"type": "integer", "minimum": 1, "maximum": 16}},
              "required": ["kind", "top", "bottom", "band"]
            }
          ]
        }
      },
      "required": ["description", "frame", "colors", "light", "fill"]
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:ui-theme\\.[a-z][a-z0-9.-]{0,95}$"},
    "windows": {
      "description": "One window look per surface: battle windows (canvas), page windows such as menus, inventory, saves, Settings and dialogue (CSS border-image), and the nameplate behind page window titles.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "battle": {"$ref": "#/definitions/window"},
        "page": {"$ref": "#/definitions/window"},
        "nameplate": {"$ref": "#/definitions/window"}
      },
      "required": ["battle"]
    },
    "battleText": {
      "description": "Text and pointer colours drawn on the battle windows.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/definitions/hex"},
        "muted": {"$ref": "#/definitions/hex"},
        "disabled": {"$ref": "#/definitions/hex"},
        "danger": {"$ref": "#/definitions/hex"},
        "cursor": {"$ref": "#/definitions/hex"},
        "outline": {"$ref": "#/definitions/hex"}
      },
      "required": ["text", "muted", "disabled", "danger", "cursor", "outline"]
    }
  },
  "required": ["schemaVersion", "id", "windows", "battleText"]
}
