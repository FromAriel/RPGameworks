{
  "schemaVersion": 1,
  "id": "demo:ui-theme.classic-blue",
  "windows": {
    "battle": {
      "description": "Classic JRPG blue window: thin white bevel, dark outline, 1-px corner notch, banded blue fill (Ariel's chosen battle look).",
      "frame": { "profile": [1, 2], "corner": "notch" },
      "ornament": "medium",
      "colors": { "ramp": ["#1a2250", "#4c5ca0", "#8fa2d8", "#c4cdec", "#e8ecf6", "#ffffff"] },
      "light": { "azimuth": 225, "elevation": 40, "steps": 6, "outline": true, "shadow": false },
      "fill": { "kind": "bands", "top": "#3050b8", "bottom": "#0c1854", "band": 4 }
    }
  },
  "battleText": {
    "text": "#ffffff",
    "muted": "#c2cbe6",
    "disabled": "#8a93b0",
    "danger": "#ff9c8a",
    "cursor": "#ffffff",
    "outline": "#05070e"
  }
}
